# ---------------------------------------------------------------------------
# Runtime configuration for the AlertMe API.
#
# This file replaces appsettings.json. Program.cs loads it into the process
# environment before the host is built, and ASP.NET Core's EnvironmentVariables
# provider maps "__" to ":" — so Jwt__Key here is read as Jwt:Key in code.
#
# Nesting rules:
#   Section__Key        -> "Section": { "Key": ... }
#   Section__List__0    -> "Section": { "List": [ first, ... ] }
#
# A real environment variable (systemd unit, docker -e) overrides anything set
# here, so the same build can be repointed without editing this file.
#
# Template only. Copy to .env and fill in real values; .env is gitignored.
# ---------------------------------------------------------------------------

# --- Hosting ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
AllowedHosts=*

# --- Logging ---------------------------------------------------------------
# Serilog's levels are set in Program.cs; these drive the Microsoft.Extensions
# logging pipeline that still sits underneath it.
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# --- Database --------------------------------------------------------------
ConnectionStrings__DefaultConnection="Server=localhost;Database=alertMe;Username=root;Password=YOUR_DB_PASSWORD;"

# --- JWT -------------------------------------------------------------------
# Program.cs refuses to start if the key is missing or under 32 bytes, because
# a fallback key would let anyone forge a token for any user.
Jwt__Key="CHANGE_ME_AT_LEAST_32_BYTES_LONG_SECRET"
Jwt__Issuer="VeloxApi"
Jwt__Audience="VeloxClient"
Jwt__DurationInMinutes=60

# --- Accounts --------------------------------------------------------------
# Google sign-in only accepts tokens issued to this client ID - the same value
# as VITE_GOOGLE_CLIENT_ID in the dashboard. Google sign-in returns 503 until set.
Google__ClientId="YOUR_GOOGLE_CLIENT_ID"

# Password for the admin@example.com account the seeder creates on an empty
# database. Leave unset and no admin account is created.
Seed__AdminPassword=

# --- CORS ------------------------------------------------------------------
# Required — startup throws if the list is empty. These are the exact browser
# origins allowed to call the API with credentials (SignalR needs credentials,
# which is why "*" is not an option). Native mobile apps are not browsers and
# need no entry here. Add the deployed dashboard origin before going live.
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:8080
Cors__AllowedOrigins__2=http://localhost:3000

# --- Telegram alerts -------------------------------------------------------
Telegram__BotToken="YOUR_TELEGRAM_BOT_TOKEN"
Telegram__ChatId="YOUR_TELEGRAM_CHAT_ID"

# --- Brevo (transactional email) -------------------------------------------
Brevo__ApiKey="YOUR_BREVO_API_KEY"
Brevo__SenderEmail="noreply@alertme.io"
Brevo__SenderName="AlertMe Trading Desk"

# --- Ollama (AI chat + news validation) ------------------------------------
Ollama__BaseUrl="http://localhost:11434"
Ollama__Model="mistral"
Ollama__TimeoutSeconds=300

# --- World News API --------------------------------------------------------
WorldNewsApi__ApiKey="YOUR_WORLDNEWSAPI_KEY"
WorldNewsApi__BaseUrl="https://api.worldnewsapi.com"
