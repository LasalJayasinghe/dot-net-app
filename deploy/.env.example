# Compose-level secrets. Copy to deploy/.env on the server and `chmod 600` it.
#
# Generate every password with:  openssl rand -hex 32
# Hex only - a ";" would break the MySQL connection string and a "$" breaks compose interpolation.

MYSQL_DATABASE=alertMe
MYSQL_USER=alertme
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > the token in the install command
TUNNEL_TOKEN=

# Exact origin of the Cloudflare-hosted dashboard, no trailing slash
FRONTEND_ORIGIN=https://insight-dashboard.<your-account>.workers.dev
