# App settings for the API container. Copy to deploy/api.env on the server and `chmod 600` it.
# Same "Section__Key" format as the root .env.example. The connection string, CORS origin and
# environment name are set in docker-compose.yml from deploy/.env - don't repeat them here.
#
# The old server was compromised: every value below must be NEW, not copied from it.

# Reject requests whose Host header isn't the API's public hostname
AllowedHosts=api.<your-domain>

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# openssl rand -base64 48
Jwt__Key=
Jwt__Issuer=VeloxApi
Jwt__Audience=VeloxClient
Jwt__DurationInMinutes=60

# Extra browser origins beyond FRONTEND_ORIGIN (index 0 is taken by docker-compose.yml)
# Cors__AllowedOrigins__1=https://dashboard.<your-domain>

Telegram__BotToken=
Telegram__ChatId=

Push__Enabled=true
Push__ExpoAccessToken=

Brevo__ApiKey=
Brevo__SenderEmail=noreply@alertme.io
Brevo__SenderName=AlertMe Trading Desk

# Not running on this VPS yet - AI chat and news validation will fail until this points somewhere.
# Keep the timeout short so those requests fail fast instead of tying up threads for 5 minutes.
Ollama__BaseUrl=http://127.0.0.1:11434
Ollama__Model=mistral
Ollama__TimeoutSeconds=10

WorldNewsApi__ApiKey=
WorldNewsApi__BaseUrl=https://api.worldnewsapi.com
